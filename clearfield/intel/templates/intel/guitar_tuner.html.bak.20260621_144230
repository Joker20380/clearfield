
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Настройка гитары онлайн</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(255, 193, 7, 0.22), transparent 32%),
        radial-gradient(circle at bottom right, rgba(111, 66, 193, 0.22), transparent 34%),
        #101015;
      color: #fff;
      min-height: 100vh;
    }

    .page {
      min-height: 100vh;
      padding: 70px 18px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card {
      width: 100%;
      max-width: 980px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 30px;
      padding: 38px;
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42);
      backdrop-filter: blur(18px);
    }

    .kicker {
      color: #ffc107;
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(36px, 6vw, 68px);
      line-height: .95;
      margin: 0 0 16px;
      letter-spacing: -0.05em;
    }

    .subtitle {
      max-width: 760px;
      color: rgba(255,255,255,.72);
      font-size: 18px;
      line-height: 1.55;
      margin-bottom: 32px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 22px;
    }

    .panel {
      background: rgba(0,0,0,.25);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 24px;
      padding: 28px;
    }

    .label {
      color: rgba(255,255,255,.6);
      font-size: 14px;
      margin-bottom: 8px;
    }

    .note {
      font-size: 96px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -0.06em;
    }

    .freq {
      color: rgba(255,255,255,.72);
      font-size: 18px;
      margin-top: 8px;
      min-height: 28px;
    }

    .status {
      margin-top: 18px;
      min-height: 34px;
      font-size: 22px;
      font-weight: 800;
    }

    .ok { color: #45e68a; }
    .low { color: #61b8ff; }
    .high { color: #ff7676; }

    .meter {
      position: relative;
      height: 96px;
      margin-top: 24px;
    }

    .meter-line {
      position: absolute;
      top: 46px;
      left: 0;
      right: 0;
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(90deg, #61b8ff, #45e68a, #ff7676);
    }

    .meter-center {
      position: absolute;
      top: 20px;
      left: 50%;
      width: 3px;
      height: 56px;
      background: white;
      border-radius: 999px;
      opacity: .85;
    }

    .needle {
      position: absolute;
      top: 8px;
      left: 50%;
      width: 30px;
      height: 76px;
      transform: translateX(-50%);
      transition: left .1s ease;
    }

    .needle:before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      width: 4px;
      height: 72px;
      transform: translateX(-50%);
      background: white;
      border-radius: 999px;
      box-shadow: 0 0 18px rgba(255,255,255,.65);
    }

    .cents {
      display: flex;
      justify-content: space-between;
      color: rgba(255,255,255,.5);
      font-size: 13px;
    }

    .strings-title {
      font-size: 22px;
      font-weight: 900;
      margin-bottom: 18px;
    }

    .string-list {
      display: grid;
      gap: 10px;
    }

    .string {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 16px;
      border-radius: 16px;
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.1);
    }

    .string b {
      font-size: 18px;
    }

    .string span {
      color: rgba(255,255,255,.65);
      text-align: right;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 30px;
    }

    button {
      border: 0;
      border-radius: 999px;
      padding: 15px 24px;
      font-weight: 900;
      cursor: pointer;
      font-size: 15px;
    }

    .primary {
      background: #ffc107;
      color: #151515;
    }

    .secondary {
      background: rgba(255,255,255,.12);
      color: white;
      border: 1px solid rgba(255,255,255,.16);
    }

    .hint {
      margin-top: 22px;
      color: rgba(255,255,255,.55);
      font-size: 14px;
    }

    @media (max-width: 820px) {
      .card { padding: 24px; }
      .grid { grid-template-columns: 1fr; }
      .note { font-size: 76px; }
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="card">
      <div class="kicker">Online Guitar Tool</div>
      <h1>Настройка гитары</h1>
      <p class="subtitle">
        Включи микрофон, сыграй открытую струну и смотри отклонение.
        Это MVP-страница: визуально уже можно оценить будущий сервис.
      </p>

      <div class="grid">
        <div class="panel">
          <div class="label">Текущая нота</div>
          <div id="currentNote" class="note">—</div>
          <div id="frequency" class="freq">Ожидание сигнала</div>
          <div id="tuningStatus" class="status">Нажми «Включить тюнер»</div>

          <div class="meter">
            <div class="meter-line"></div>
            <div class="meter-center"></div>
            <div id="needle" class="needle"></div>
          </div>

          <div class="cents">
            <span>ниже</span>
            <span>точно</span>
            <span>выше</span>
          </div>
        </div>

        <div class="panel">
          <div class="strings-title">Стандартный строй</div>

          <div class="string-list">
            <div class="string"><b>E2</b><span>82.41 Hz — 6 струна</span></div>
            <div class="string"><b>A2</b><span>110.00 Hz — 5 струна</span></div>
            <div class="string"><b>D3</b><span>146.83 Hz — 4 струна</span></div>
            <div class="string"><b>G3</b><span>196.00 Hz — 3 струна</span></div>
            <div class="string"><b>B3</b><span>246.94 Hz — 2 струна</span></div>
            <div class="string"><b>E4</b><span>329.63 Hz — 1 струна</span></div>
          </div>
        </div>
      </div>

      <div class="actions">
        <button id="startTuner" class="primary" type="button">Включить тюнер</button>
        <button id="stopTuner" class="secondary" type="button">Остановить</button>
      </div>

      <div class="hint">
        Микрофон работает только на HTTPS или localhost. На workhub-rso.ru HTTPS есть, значит браузер должен запросить разрешение.
      </div>
    </section>
  </main>

  <script>
    (function () {
      const startBtn = document.getElementById("startTuner");
      const stopBtn = document.getElementById("stopTuner");
      const noteEl = document.getElementById("currentNote");
      const freqEl = document.getElementById("frequency");
      const statusEl = document.getElementById("tuningStatus");
      const needleEl = document.getElementById("needle");

      let audioContext = null;
      let analyser = null;
      let mediaStream = null;
      let rafId = null;

      const noteNames = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];

      const targetStrings = [
        { note: "E2", freq: 82.41 },
        { note: "A2", freq: 110.00 },
        { note: "D3", freq: 146.83 },
        { note: "G3", freq: 196.00 },
        { note: "B3", freq: 246.94 },
        { note: "E4", freq: 329.63 }
      ];

      function frequencyToMidi(freq) {
        return Math.round(69 + 12 * Math.log2(freq / 440));
      }

      function midiToNoteName(midi) {
        const name = noteNames[((midi % 12) + 12) % 12];
        const octave = Math.floor(midi / 12) - 1;
        return name + octave;
      }

      function centsOff(freq, targetFreq) {
        return 1200 * Math.log2(freq / targetFreq);
      }

      function findNearestString(freq) {
        let best = targetStrings[0];
        let bestDiff = Infinity;

        for (const item of targetStrings) {
          const diff = Math.abs(centsOff(freq, item.freq));
          if (diff < bestDiff) {
            best = item;
            bestDiff = diff;
          }
        }

        return best;
      }

      function autoCorrelate(buffer, sampleRate) {
        const size = buffer.length;
        let rms = 0;

        for (let i = 0; i < size; i++) {
          rms += buffer[i] * buffer[i];
        }

        rms = Math.sqrt(rms / size);

        if (rms < 0.01) {
          return -1;
        }

        const correlations = new Array(size).fill(0);

        for (let lag = 0; lag < size; lag++) {
          for (let i = 0; i < size - lag; i++) {
            correlations[lag] += buffer[i] * buffer[i + lag];
          }
        }

        let d = 0;
        while (d < size - 1 && correlations[d] > correlations[d + 1]) {
          d++;
        }

        let maxVal = -1;
        let maxPos = -1;

        for (let i = d; i < size; i++) {
          if (correlations[i] > maxVal) {
            maxVal = correlations[i];
            maxPos = i;
          }
        }

        if (maxPos <= 0) {
          return -1;
        }

        return sampleRate / maxPos;
      }

      function setStatus(text, cls) {
        statusEl.className = "status " + (cls || "");
        statusEl.textContent = text;
      }

      function updateNeedle(cents) {
        const limited = Math.max(-50, Math.min(50, cents));
        needleEl.style.left = (50 + limited) + "%";
      }

      function tick() {
        const bufferLength = analyser.fftSize;
        const buffer = new Float32Array(bufferLength);

        analyser.getFloatTimeDomainData(buffer);

        const frequency = autoCorrelate(buffer, audioContext.sampleRate);

        if (frequency > 40 && frequency < 500) {
          const midi = frequencyToMidi(frequency);
          const detectedNote = midiToNoteName(midi);
          const nearest = findNearestString(frequency);
          const cents = centsOff(frequency, nearest.freq);

          noteEl.textContent = detectedNote;
          freqEl.textContent = frequency.toFixed(2) + " Hz → цель " + nearest.note;

          updateNeedle(cents);

          if (Math.abs(cents) <= 5) {
            setStatus("Точно: " + nearest.note, "ok");
          } else if (cents < 0) {
            setStatus("Ниже нужной ноты: подтяни струну", "low");
          } else {
            setStatus("Выше нужной ноты: ослабь струну", "high");
          }
        } else {
          noteEl.textContent = "—";
          freqEl.textContent = "Сыграй открытую струну";
          setStatus("Ожидание чистого сигнала", "");
          updateNeedle(0);
        }

        rafId = requestAnimationFrame(tick);
      }

      async function startTuner() {
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });

          audioContext = new (window.AudioContext || window.webkitAudioContext)();
          analyser = audioContext.createAnalyser();
          analyser.fftSize = 2048;

          const source = audioContext.createMediaStreamSource(mediaStream);
          source.connect(analyser);

          setStatus("Слушаю гитару", "ok");
          tick();
        } catch (error) {
          console.error(error);
          setStatus("Нет доступа к микрофону", "high");
          freqEl.textContent = "Проверь разрешение микрофона в браузере";
        }
      }

      function stopTuner() {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }

        if (mediaStream) {
          mediaStream.getTracks().forEach(track => track.stop());
          mediaStream = null;
        }

        if (audioContext) {
          audioContext.close();
          audioContext = null;
        }

        noteEl.textContent = "—";
        freqEl.textContent = "Тюнер остановлен";
        setStatus("Нажми «Включить тюнер»", "");
        updateNeedle(0);
      }

      startBtn.addEventListener("click", startTuner);
      stopBtn.addEventListener("click", stopTuner);
    })();
  </script>
</body>
</html>

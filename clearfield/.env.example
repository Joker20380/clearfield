# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=clearfield.example.com
CSRF_TRUSTED_ORIGINS=https://clearfield.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=clearfield
DATABASE_USER=clearfield
DATABASE_PASSWORD=replace-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# Locale
LANGUAGE_CODE=ru-ru
TIME_ZONE=Europe/Moscow

# Clearfield
CLEARFIELD_DEFAULT_REGION=RU
CLEARFIELD_DEFAULT_TOPIC=medicine
CLEARFIELD_BRIEF_HOURS=72
CLEARFIELD_MIN_EVIDENCE=2

# LLM endpoint reached directly or through bin/ensure_llm_tunnel.sh
LLM_ENABLED=True
OLLAMA_BASE_URL=http://127.0.0.1:18081
OLLAMA_MODEL=qwen3-30b-a3b
OLLAMA_TIMEOUT=240
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=2500

# Optional email
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
